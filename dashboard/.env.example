PORT=3100
DATA_DIR=./data

# --- Security ---
# Shared secret that cameras / Milestone rules must send as header "X-API-Key" to POST /api/ingest
INGEST_API_KEY=change-me
# Optional HTTP basic auth for the dashboard + API (leave blank to disable)
DASHBOARD_USER=
DASHBOARD_PASS=

# --- Milestone XProtect (API Gateway) ---
# Base URL of the XProtect API Gateway, e.g. https://vms.example.com
MILESTONE_BASE_URL=
MILESTONE_USERNAME=
MILESTONE_PASSWORD=
# Poll alarms from the API Gateway for ANPR/LPR alarms (experimental, see README). 0 = off
MILESTONE_POLL_ALARMS=0
MILESTONE_POLL_SECONDS=3

# --- Behaviour ---
DEBOUNCE_SECONDS=30          # ignore repeat reads of same plate on same camera
REENTRY_GRACE_SECONDS=300    # entry read for a plate still on site within this window = duplicate
OVERSTAY_HOURS=8             # flag vehicles on site longer than this
RETENTION_DAYS=90            # purge reads/visits older than this (plates are personal data)
MIN_CONFIDENCE=0             # drop reads below this confidence (0-100)
# Path of the alarms endpoint on the API Gateway (differs between XProtect versions)
MILESTONE_ALARMS_PATH=/api/rest/v1/alarms
# For a self-signed management-server certificate, prefer NODE_EXTRA_CA_CERTS=/path/to/ca.pem over disabling TLS checks
